# ============================================================
# MasterAI Academy — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commitar o .env — está no .gitignore
# ============================================================

# ── BANCO DE DADOS ──────────────────────────────────────────
# Senha local do PostgreSQL (dev apenas — use string forte)
POSTGRES_PASSWORD=masterai_dev_2026

# URL completa para o SQLAlchemy (gerada automaticamente no docker-compose)
# Em produção no Railway, substituir pela URL fornecida pelo serviço
DATABASE_URL=postgresql://masterai:masterai_dev_2026@localhost:5432/masterai_academy

# ── SUPABASE ────────────────────────────────────────────────
# Criar projeto em https://supabase.com
# Copiar de: Project Settings → API

# URL do projeto Supabase (obrigatório no backend para validar JWT com “JWT Signing Keys” / JWKS)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co

# Chave pública (anon) — usada no frontend, pode expor
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de serviço — APENAS no backend, nunca expor no frontend
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret legado — só tokens HS256 antigos (Project Settings → API → JWT Settings → JWT Secret)
# Projetos novos usam JWKS; o backend usa SUPABASE_URL em vez disto quando o token for ES256/RS256.
SUPABASE_JWT_SECRET=

# ── LLM (BrainAgent) — padrão: Ollama Cloud ─────────────────
# ollama_cloud (default) | anthropic
LLM_PROVIDER=ollama_cloud
# Chave: https://ollama.com/settings/keys — modelos cloud: https://ollama.com/search?c=cloud
# Sem aspas na linha. Erro 401 na cloud = chave inválida na conta Ollama (gere outra em ollama.com/settings/keys).
# Host base só (sem /api no fim — o cliente usa …/api/chat automaticamente)
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
# Docker no Windows/Mac com Ollama instalado no host (porta 11434), sem cloud:
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_API_KEY=
# OLLAMA_MODEL=llama3.2 (ou o modelo que você deu pull localmente)

# ── ANTHROPIC (opcional; use LLM_PROVIDER=anthropic) ─────────
# https://console.anthropic.com — NUNCA no frontend
ANTHROPIC_API_KEY=

# ── CHROMADB ────────────────────────────────────────────────
# Token de autenticação do ChromaDB (gerar string aleatória forte)
# Exemplo: python3 -c "import secrets; print(secrets.token_hex(32))"
CHROMADB_TOKEN=gere_uma_string_aleatoria_forte_aqui

# ── REDIS ───────────────────────────────────────────────────
# Senha do Redis local
REDIS_PASSWORD=masterai_redis_2026

# URL completa (gerada automaticamente)
REDIS_URL=redis://:masterai_redis_2026@localhost:6379/0

# ── SEGURANÇA ───────────────────────────────────────────────
# Chave para assinar JWTs internos
# Gerar com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=gere_uma_string_aleatoria_forte_aqui

# ── AMBIENTE ────────────────────────────────────────────────
# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Apenas desenvolvimento local — não usar em produção
DEV_SKIP_AUTH=false
DEV_STUDENT_ID=

# CORS — origens extras (produção), separadas por vírgula
# CORS_ALLOW_ORIGINS=https://seu-app.vercel.app

# ── FRONTEND (Next.js) ──────────────────────────────────────
# Apenas variáveis com NEXT_PUBLIC_ ficam no frontend
# O resto fica apenas no backend

# Proxy same-origin (default): Next.js encaminha /api/backend → FastAPI.
# No Docker Compose, o frontend usa BACKEND_INTERNAL_URL (ver docker-compose.yml).
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Opcional: chamar a API direto no browser (desliga o proxy padrão /api/backend)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase (público — vai para o browser)
# NEXT_PUBLIC_SUPABASE_URL=    ← mesmo valor de SUPABASE_URL acima
# NEXT_PUBLIC_SUPABASE_ANON_KEY= ← mesmo valor de SUPABASE_ANON_KEY acima

# ── RATE LIMITS ─────────────────────────────────────────────
# Chamadas ao BrainAgent por aluno por hora
BRAINAGENT_RATE_LIMIT_PER_HOUR=20

# ── CONFIGURAÇÕES DO BRAINAGENT ─────────────────────────────
# Modelo Anthropic (só se LLM_PROVIDER=anthropic)
ANTHROPIC_MODEL=claude-sonnet-4-20250514
BRAINAGENT_MAX_TOKENS_EVALUATION=1500
BRAINAGENT_MAX_TOKENS_CHAT=800
BRAINAGENT_MAX_TOKENS_RECOMMENDATION=500

# Cache de recomendações (segundos)
BRAINAGENT_CACHE_TTL=3600
